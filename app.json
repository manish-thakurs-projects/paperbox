{
  "expo": {
    "name": "PaperBox",
    "slug": "paperbox",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "paperbox.dustmedia.org",
      "versionCode": 5,
      "permissions": ["CAMERA"],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "paperbox.dustmedia.org",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan documents and capture images.",
        "NSFaceIDUsageDescription": "Allow PaperBox to use Face ID to unlock your vault."
      }
    },
    "androidStatusBarColor": "#000000",
    "androidStatusBarStyle": "light-content",
    "androidNavigationBarColor": "#000000",
    "androidNavigationBarStyle": "dark",
    "plugins": [
      "expo-document-picker",
      "expo-video",
      "expo-local-authentication",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "This app needs camera access to scan documents."
        }
      ],
      "expo-secure-store"
    ]
  }
}
